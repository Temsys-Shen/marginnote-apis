{
  "name": "mnapis",
  "version": "0.39.0",
  "description": "mnapis：MarginNote HTTP 接口文档站，Fumadocs + fumadocs-openapi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
